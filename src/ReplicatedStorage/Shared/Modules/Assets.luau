-- True when an asset string or numeric ID has not been filled in yet.
function Assets.isPlaceholder(id: string | number): boolean
	return id == PLACEHOLDER_ASSET or id == PLACEHOLDER_ID or id == "" or id == "rbxassetid://"
end

return table.freeze(Assets)
